{
  "info": {
    "_postman_id": "6fbdf9d4-3e57-4b0e-bcc4-7686d93618a2",
    "name": "OneFutbol API",
    "description": "Colección de requests para la API NestJS OneFutbol. Importa este archivo en Postman y selecciona el environment/local variables configuradas en la colección. El servidor usa el puerto 4000 según el .env del proyecto. Crea primero un deporte y un equipo, luego su relación. Los IDs se guardan automáticamente al crear recursos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "deporteId", "value": "1", "type": "string" },
    { "key": "equipoId", "value": "1", "type": "string" },
    { "key": "relacionId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Deportes",
      "item": [
        {
          "name": "Crear deporte",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { const data = pm.response.json(); if (data.id) pm.collectionVariables.set('deporteId', data.id); }"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Fútbol\",\n  \"descripcion\": \"Fútbol asociación\",\n  \"esColectivo\": true,\n  \"minJugadores\": 11,\n  \"maxJugadores\": 11,\n  \"activo\": true\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/deportes", "host": ["{{baseUrl}}"], "path": ["deportes"] }, "description": "Guarda deporteId en variables de colección al crear el recurso." }
        },
        { "name": "Listar deportes", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/deportes", "host": ["{{baseUrl}}"], "path": ["deportes"] } } },
        { "name": "Consultar deporte", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/deportes/{{deporteId}}", "host": ["{{baseUrl}}"], "path": ["deportes", "{{deporteId}}"] } } },
        { "name": "Equipos de un deporte", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/deportes/{{deporteId}}/equipos", "host": ["{{baseUrl}}"], "path": ["deportes", "{{deporteId}}", "equipos"] } } },
        { "name": "Actualizar deporte", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"Fútbol sala\",\n  \"maxJugadores\": 5\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/deportes/{{deporteId}}", "host": ["{{baseUrl}}"], "path": ["deportes", "{{deporteId}}"] } } },
        { "name": "Eliminar deporte", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/deportes/{{deporteId}}", "host": ["{{baseUrl}}"], "path": ["deportes", "{{deporteId}}"] }, "description": "Falla con 409 si el deporte aún tiene subdeportes o equipos asociados." } }
      ]
    },
    {
      "name": "Equipos",
      "item": [
        {
          "name": "Crear equipo (JSON, sin escudo)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { const data = pm.response.json(); if (data.id) pm.collectionVariables.set('equipoId', data.id); }"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Club Deportivo Bogotá\",\n  \"siglas\": \"CDB\",\n  \"fechaFundacion\": \"2001-05-20\",\n  \"ciudad\": \"Bogotá\",\n  \"pais\": \"Colombia\",\n  \"activo\": true\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/equipos", "host": ["{{baseUrl}}"], "path": ["equipos"] }, "description": "Guarda equipoId en variables de colección al crear el recurso." }
        },
        {
          "name": "Crear equipo (multipart con escudo)",
          "request": { "method": "POST", "header": [], "body": { "mode": "formdata", "formdata": [
            { "key": "nombre", "value": "Club Deportivo Bogotá", "type": "text" },
            { "key": "siglas", "value": "CDB", "type": "text" },
            { "key": "fechaFundacion", "value": "2001-05-20", "type": "text" },
            { "key": "ciudad", "value": "Bogotá", "type": "text" },
            { "key": "pais", "value": "Colombia", "type": "text" },
            { "key": "activo", "value": "true", "type": "text" },
            { "key": "escudo", "type": "file", "src": [] }
          ] }, "url": { "raw": "{{baseUrl}}/equipos", "host": ["{{baseUrl}}"], "path": ["equipos"] }, "description": "Después de importar, selecciona un archivo en el campo escudo. No fijes Content-Type manualmente. JPG, PNG, WEBP o GIF hasta 5 MB." }
        },
        { "name": "Listar equipos", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/equipos", "host": ["{{baseUrl}}"], "path": ["equipos"] } } },
        { "name": "Consultar equipo", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/equipos/{{equipoId}}", "host": ["{{baseUrl}}"], "path": ["equipos", "{{equipoId}}"] } } },
        { "name": "Deportes de un equipo", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/equipos/{{equipoId}}/deportes", "host": ["{{baseUrl}}"], "path": ["equipos", "{{equipoId}}", "deportes"] } } },
        { "name": "Actualizar equipo (JSON)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"ciudad\": \"Medellín\",\n  \"activo\": false\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/equipos/{{equipoId}}", "host": ["{{baseUrl}}"], "path": ["equipos", "{{equipoId}}"] } } },
        { "name": "Actualizar escudo (multipart)", "request": { "method": "PATCH", "header": [], "body": { "mode": "formdata", "formdata": [{ "key": "escudo", "type": "file", "src": [] }] }, "url": { "raw": "{{baseUrl}}/equipos/{{equipoId}}", "host": ["{{baseUrl}}"], "path": ["equipos", "{{equipoId}}"] }, "description": "Selecciona un archivo después de importar. Se conserva el resto de los datos del equipo." } },
        { "name": "Eliminar equipo", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/equipos/{{equipoId}}", "host": ["{{baseUrl}}"], "path": ["equipos", "{{equipoId}}"] }, "description": "Falla con 409 si el equipo aún está inscrito en deportes." } }
      ]
    },
    {
      "name": "Relaciones equipo-deporte",
      "item": [
        {
          "name": "Inscribir equipo en deporte",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { const data = pm.response.json(); if (data.id) pm.collectionVariables.set('relacionId', data.id); }"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fechaInscripcion\": \"2026-11-18\",\n  \"entrenador\": \"Laura Gómez\",\n  \"categoria\": \"Mayores\",\n  \"equipoId\": {{equipoId}},\n  \"deporteId\": {{deporteId}}\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/equipos-deportes", "host": ["{{baseUrl}}"], "path": ["equipos-deportes"] }, "description": "Ejecuta después de crear equipo y deporte. Los IDs se insertan como números JSON." }
        },
        { "name": "Listar relaciones", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/equipos-deportes", "host": ["{{baseUrl}}"], "path": ["equipos-deportes"] } } },
        { "name": "Consultar relación", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/equipos-deportes/{{relacionId}}", "host": ["{{baseUrl}}"], "path": ["equipos-deportes", "{{relacionId}}"] } } },
        { "name": "Actualizar relación", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"categoria\": \"Sub-20\",\n  \"entrenador\": \"Carlos Ruiz\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/equipos-deportes/{{relacionId}}", "host": ["{{baseUrl}}"], "path": ["equipos-deportes", "{{relacionId}}"] } } },
        { "name": "Eliminar relación", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/equipos-deportes/{{relacionId}}", "host": ["{{baseUrl}}"], "path": ["equipos-deportes", "{{relacionId}}"] } } }
      ]
    }
  ]
}
